rules_version = '2';

// ============================================================
// 資料架構說明（Cloud Functions 中介層版本）
// ============================================================
// slots/{slotId}
//   → 公開資料：只有 date, time, note, status, source 欄位，完全不含任何病患個資。
//     任何人都可以直接讀取（顯示可預約時段）。
//     新增/刪除/狀態變更（開放↔已預約）一律只能透過 Cloud Functions
//     （bookSlot / cancelMyBooking / adminAddSlot / adminDeleteSlot / adminCancelBooking...）
//     完成，前端不再直接寫入這個 collection，所以這裡的 write 規則只保留給
//     已登入的管理員作為備援／除錯用途，Cloud Functions 用的是 Admin SDK，
//     不受這裡的規則限制。
//
// bookings/{bookingId}、waitlist/{entryId}、templateMeta/{docId}、auditLogs/{logId}
//   → 全部是私密資料或內部設定，一律拒絕前端直接讀寫。
//     所有存取都必須經過 Cloud Functions，由伺服器端程式碼驗證身分
//     （電話+生日核對）與管理員權限（Firebase Authentication 已登入）後才能操作。
//     這是目前最高等級的保護：資料庫本身完全不接受前端直接連線。
//     auditLogs 記錄每次呼叫 Cloud Function 的時間、來源 IP、User-Agent，
//     供日後若懷疑遭入侵時，可佐證來源 IP／是否來自境外。
//
// patients/{phoneHash}/bookings/{bookingId}（舊版）
//   → 舊架構已不再使用，一併關閉存取。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 公開的時段資訊：無病患個資
    match /slots/{slotId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 病患個資與候補名單：完全交給 Cloud Functions 處理，前端一律拒絕
    match /bookings/{bookingId} {
      allow read, write: if false;
    }
    match /waitlist/{entryId} {
      allow read, write: if false;
    }
    match /templateMeta/{docId} {
      allow read, write: if false;
    }
    // 稽核紀錄：只有 Cloud Functions（Admin SDK）能寫入，前端一律拒絕直接讀寫，
    // 管理員需透過 adminGetAuditLogs 這支 Cloud Function 讀取
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // 舊版資料結構，全面關閉存取
    match /clinicData/{docId} {
      allow read, write: if false;
    }
    match /patients/{phoneHash}/bookings/{bookingId} {
      allow read, write: if false;
    }

    // 其餘路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
