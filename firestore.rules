rules_version = '2';

// ============================================================
// 資料架構說明（依「不能讓外人取得非特定人士個資」為最高原則設計）
// ============================================================
// 核心邏輯：
//   - 任何會「讀到別人資料」的操作 → 一定要經過 Cloud Function 或要求已登入管理員，
//     因為 Firestore 規則沒辦法限制「查詢時只能帶哪些篩選條件」，
//     一旦開放讀取，就等於任何人都能寫程式繞過畫面、直接把整個 collection 撈光。
//   - 純粹「寫入自己的資料」「取消/刪除已知的一筆資料」→ 可以開放不需驗證，
//     風險是「有心人士亂寫/亂刪資料」，以每日備份因應，不影響「個資外洩」這個核心防線。
//
// slots/{slotId} → 公開時段時間表，不含個資。
//   任何人可讀。新增/刪除需要登入管理員；「開放↔已預約」狀態互換不需登入
//   （但只能切換 status 欄位，其餘欄位不能被同時竄改）。
//
// bookings/{bookingId} → 病患個資。
//   任何人都能建立自己的預約（create）。
//   讀取（尤其是列出全部）需要登入管理員 —— 這是防止外人撈走所有病患資料的關鍵防線。
//   更新只開放「取消」這個狀態轉換（active→cancelled，且其餘欄位不能變），不需要登入；
//   已登入管理員則不受此限制。刪除需要登入管理員。
//
// waitlist/{entryId} → 候補名單，含個資。
//   任何人都能送出候補登記（create）與移除一筆已知的候補（delete，不需要登入，
//   因為刪除操作實際上只有拿到後台完整名單的管理員才會知道要刪哪一筆）。
//   讀取全部候補名單、修改內容則需要登入管理員。
//
// templateMeta/{docId} → 固定時段的內部設定（已停開清單），不含個資，需要登入才能讀寫。
//
// auditLogs/{logId} → 稽核紀錄，只有 Cloud Functions（Admin SDK）能寫入（避免有人
//   竄改或偽造紀錄），已登入管理員可以直接讀取（不需要再經過 Cloud Function）。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /slots/{slotId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || (
        resource.data.date   == request.resource.data.date &&
        resource.data.time   == request.resource.data.time &&
        resource.data.note   == request.resource.data.note &&
        resource.data.source == request.resource.data.source &&
        resource.data.status != request.resource.data.status &&
        (request.resource.data.status == 'open' || request.resource.data.status == 'booked')
      );
    }

    match /bookings/{bookingId} {
      allow read, delete: if request.auth != null;
      allow create: if true;
      allow update: if request.auth != null || (
        resource.data.status == 'active' &&
        request.resource.data.status == 'cancelled' &&
        resource.data.name  == request.resource.data.name &&
        resource.data.birth == request.resource.data.birth &&
        resource.data.phone == request.resource.data.phone &&
        resource.data.issue == request.resource.data.issue &&
        resource.data.slotId == request.resource.data.slotId
      );
    }

    match /waitlist/{entryId} {
      allow create, delete: if true;
      allow read, update: if request.auth != null;
    }

    match /templateMeta/{docId} {
      allow read, write: if request.auth != null;
    }

    match /auditLogs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 舊版資料結構，全面關閉存取
    match /clinicData/{docId} {
      allow read, write: if false;
    }
    match /patients/{phoneHash}/bookings/{bookingId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
