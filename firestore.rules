rules_version = '2';

// ============================================================
// 資料架構說明
// ============================================================
// slots/{slotId}
//   → 公開資料：只有 date, time, note, status, source 欄位，完全不含任何病患個資。
//     任何人都可以讀取（顯示可預約時段），但只有：
//       (a) 已登入的管理員 可以新增/刪除時段
//       (b) 「開放中→已預約」或「已預約→開放中」的狀態切換
//           （且必須保證 date/time/note/source 都沒被更動）可以在未登入時進行，
//           這是為了讓家長可以自行完成預約與取消，不需要註冊帳號。
//
// patients/{phoneHash}/bookings/{bookingId}
//   → 私密資料：兒童姓名、生日、電話、主要問題等。
//     phoneHash 是電話號碼經過雜湊運算後的代號，不是電話本身。
//     只有「算得出同一組雜湊值的人」（也就是知道這支電話號碼的人）才能讀寫這個路徑，
//     一般訪客隨意瀏覽 Firestore 並無法列出或猜出其他人的完整清單。
//     這不是強加密驗證，仍有電話號碼被暴力破解猜測的理論風險，
//     如需更高等級的保護，建議加上 Firebase Auth 或後端函式。
//
// {any}/bookings/{bookingId}（collection group）
//   → 只有已登入的管理員，才能用 collectionGroup 查詢橫跨所有病患的完整預約清單，
//     這是後台「時段管理」頁面顯示病患資料、以及候補名單統計所需要的權限。
//
// waitlist/{entryId}
//   → 候補登記：任何人都能送出候補登記（不需登入），
//     但完整候補名單只有登入的管理員能讀取／處理／刪除。
//
// templateMeta/{docId}
//   → 後台內部設定（例如哪些固定時段被手動停開），僅供已登入管理員讀寫。
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // 公開的時段資訊：無病患個資
    match /slots/{slotId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null || (
        resource.data.date   == request.resource.data.date &&
        resource.data.time   == request.resource.data.time &&
        resource.data.note   == request.resource.data.note &&
        resource.data.source == request.resource.data.source &&
        resource.data.status != request.resource.data.status &&
        (request.resource.data.status == 'open' || request.resource.data.status == 'booked')
      );
    }

    // 病患個資：依「電話雜湊」分區存放
    match /patients/{phoneHash}/bookings/{bookingId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // 讓已登入管理員可以用 collectionGroup 查詢，橫跨所有病患資料（後台顯示用）
    match /{path=**}/bookings/{bookingId} {
      allow read: if request.auth != null;
    }

    // 候補名單
    match /waitlist/{entryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 固定時段相關內部設定（如已停開清單）
    match /templateMeta/{docId} {
      allow read, write: if request.auth != null;
    }

    // 舊版資料結構（單一 JSON blob）已停用，全面關閉存取，避免混用
    match /clinicData/{docId} {
      allow read, write: if false;
    }

    // 其餘路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
